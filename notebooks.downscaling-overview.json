{"version":3,"kind":"Notebook","sha256":"d2e385271a404f3883db95202bfd79ab4b6953cb1770b583291889fe8a023e09","slug":"notebooks.downscaling-overview","location":"/notebooks/09_downscaling_overview.ipynb","dependencies":[],"frontmatter":{"title":"Temporal downscaling: 6h native steps to 1h","content_includes_title":false,"kernelspec":{"name":"e2s-gpu","display_name":"Python (e2s GPU)","language":"python"},"jupytext":{},"authors":[{"nameParsed":{"literal":"cgroll","family":"cgroll"},"name":"cgroll","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/cgroll/e2s-examples","copyright":"2026","numbering":{"title":{"offset":1}},"source_url":"https://github.com/cgroll/e2s-examples/blob/main/book/notebooks/09_downscaling_overview.ipynb","edit_url":"https://github.com/cgroll/e2s-examples/edit/main/book/notebooks/09_downscaling_overview.ipynb","thumbnail":"/e2s-examples/build/meteogram_t2m_munich-01003c36bfcc00ad86f4a485f1d82d73.png","exports":[{"format":"ipynb","filename":"09_downscaling_overview.ipynb","url":"/e2s-examples/build/09_downscaling_overv-b6c22a63efab973fa98b7d1d89a7a4e4.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"inlineCode","value":"InterpModAFNO","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qKQDDXq706"},{"type":"text","value":" wraps SFNO (a 6h-native prognostic model) and inserts 5\nAFNO-interpolated steps between each pair of SFNO’s own 6h outputs,\nproducing an hourly forecast. Crucially, the steps at the 6h boundaries\naren’t touched by the interpolation model - they’re SFNO’s own output,\npassed straight through. So within the single hourly zarr this experiment\nwrites, every 6th lead-time step is a genuine model prediction and\neverything in between is AFNO-synthesized.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qoP2No7t5N"}],"key":"czR44gzR5z"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"This chapter compares the two directly: the same field, the same\nrollout, once at native 6h resolution and once at the interpolated 1h\nresolution - stacked so the added temporal detail (and which of it is\n“real”) is visible at a glance.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"f6EwpMaEb2"}],"key":"T5GXqisePF"}],"key":"oIX151k584"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-24T14:00:33.835588Z","iopub.status.busy":"2026-07-24T14:00:33.835477Z","iopub.status.idle":"2026-07-24T14:00:33.957798Z","shell.execute_reply":"2026-07-24T14:00:33.957287Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import shutil\n\nimport matplotlib\nmatplotlib.use(\"Agg\")\n\nfrom e2s.paths import ProjPaths\n\npaths = ProjPaths()\npaths.ensure_directories()\n\n\ndef copy_asset(src, dst):\n    if src.exists():\n        shutil.copyfile(src, dst)\n        print(f\"Copied {src} -> {dst}\")\n    else:\n        print(f\"[WARN] {src} not found - run 02_analyse.py first.\")","key":"wJRSurllTn"},{"type":"outputs","id":"YkZDL7eeJNDtifICXLwhq","children":[],"key":"Rf9hxoXaEj"}],"key":"U8WeLR7lnC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Munich meteogram: dense vs. native-only","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qtARUZJdyj"}],"identifier":"munich-meteogram-dense-vs-native-only","label":"Munich meteogram: dense vs. native-only","html_id":"munich-meteogram-dense-vs-native-only","implicit":true,"key":"jQ78NejMcg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"t