14.887128Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport xarray as xr\n\nfrom e2s.paths import ProjPaths\n\npaths = ProjPaths()\npaths.ensure_directories()\n\n# Germany's extent plus a small margin, so the coastline/border context\n# isn't cropped tight to the data.\nGERMANY_EXTENT = [5.0, 16.0, 46.5, 56.0]  # lon_min, lon_max, lat_min, lat_max","key":"mYwwvBx9km"},{"type":"outputs","id":"0dqIxJ7dkemKhnaLeS4pN","children":[],"key":"Dn3LRTQktP"}],"key":"ctQDOOyCUp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The mask","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yuZK2azuEO"}],"identifier":"the-mask","label":"The mask","html_id":"the-mask","implicit":true,"key":"p5uD3fQ2jQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Population per native (0.25 deg) grid cell, zero outside Germany’s\nborder by construction - see ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Bui7WJXIXz"},{"type":"inlineCode","value":"02_build_germany_mask.py","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VBTRSci9BU"},{"type":"text","value":". The\nconcentration around Berlin, the Rhine-Ruhr area, and Munich is visible\nat a glance; large stretches (the former East Germany, the Alps) barely\nregister.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jF5cnZ13hu"}],"key":"d5tKFPALnt"}],"key":"RWi5LORA5w"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-27T09:12:14.890419Z","iopub.status.busy":"2026-07-27T09:12:14.890160Z","iopub.status.idle":"2026-07-27T09:12:16.996276Z","shell.execute_reply":"2026-07-27T09:12:16.995020Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mask_ds = xr.open_dataset(paths.germany_population_mask_path)\nlat_name = next(n for n in (\"lat\", \"latitude\") if n in mask_ds.coords)\nlon_name = next(n for n in (\"lon\", \"longitude\") if n in mask_ds.coords)\n\nfig = plt.figure(figsize=(7, 8))\nax = plt.axes(projection=ccrs.PlateCarree())\nax.set_extent(GERMANY_EXTENT, crs=ccrs.PlateCarree())\nax.coastlines(resolution=\"50m\", linewidth=0.8, color=\"#444444\")\nax.add_feature(cfeature.BORDERS, linewidth=0.8, edgecolor=\"#444444\")\n\n# Zero-population cells (outside Germany, or uninhabited inside it) plotted\n# as transparent rather than dark-purple-at-zero, so the border/coastline\n# underneath does the work of showing Germany's outline.\npopulation = mask_ds[\"population_weight\"].where(mask_ds[\"population_weight\"] > 0)\npcm = ax.pcolormesh(\n    mask_ds[lon_name], mask_ds[lat_name], population,\n    transform=ccrs.PlateCarree(), cmap=\"viridis\", shading=\"auto\",\n)\nfig.colorbar(pcm, ax=ax, orientation=\"vertical\", pad=0.05, label=\"Population per grid cell\")\nax.set_title(\"Germany population-weighting mask (PECD v4.2 / SEDAC 2020)\")\nfig.tight_layout()\nfig.savefig(paths.germany_book_path / \"population_mask.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"S4iv8SOSWW"},{"type":"outputs","id":"WGhjvZQBlBbKruwU17Hoq","children":[],"key":"COrpbWJKTn"}],"key":"xJhIZPfriZ"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/e2s-examples/build/population_mask-95e052890adb0bb03014f089437904d0.png","alt":"Population per native grid cell across Germany - the weighting applied\nbelow instead of a flat area-weighted mean.","data":{"altTextIsAutoGenerated":true},"key":"wCHyu8n5Z1","urlSource":"../../output/germany/book/population_mask.png"},{"type":"caption","children":[{