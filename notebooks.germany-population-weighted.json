14.887128Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"import cartopy.crs as ccrs\nimport cartopy.feature as cfeature\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport xarray as xr\n\nfrom e2s.paths import ProjPaths\n\npaths = ProjPaths()\npaths.ensure_directories()\n\n# Germany's extent plus a small margin, so the coastline/border context\n# isn't cropped tight to the data.\nGERMANY_EXTENT = [5.0, 16.0, 46.5, 56.0]  # lon_min, lon_max, lat_min, lat_max","key":"SHerKNdwu1"},{"type":"outputs","id":"x_hmZRwnsPpHFb0DepLOh","children":[],"key":"Pnc7wnYci1"}],"key":"kvr00XEACs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The mask","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nBgmcPpMY1"}],"identifier":"the-mask","label":"The mask","html_id":"the-mask","implicit":true,"key":"Q2DGJv9MdL"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Population per native (0.25 deg) grid cell, zero outside Germany’s\nborder by construction - see ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jy0Hkf6UXL"},{"type":"inlineCode","value":"02_build_germany_mask.py","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hcflVLFVuI"},{"type":"text","value":". The\nconcentration around Berlin, the Rhine-Ruhr area, and Munich is visible\nat a glance; large stretches (the former East Germany, the Alps) barely\nregister.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"V6tfjeTSfd"}],"key":"JC0X2nJPgS"}],"key":"S4aAe8k8HZ"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-07-27T09:12:14.890419Z","iopub.status.busy":"2026-07-27T09:12:14.890160Z","iopub.status.idle":"2026-07-27T09:12:16.996276Z","shell.execute_reply":"2026-07-27T09:12:16.995020Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"mask_ds = xr.open_dataset(paths.germany_population_mask_path)\nlat_name = next(n for n in (\"lat\", \"latitude\") if n in mask_ds.coords)\nlon_name = next(n for n in (\"lon\", \"longitude\") if n in mask_ds.coords)\n\nfig = plt.figure(figsize=(7, 8))\nax = plt.axes(projection=ccrs.PlateCarree())\nax.set_extent(GERMANY_EXTENT, crs=ccrs.PlateCarree())\nax.coastlines(resolution=\"50m\", linewidth=0.8, color=\"#444444\")\nax.add_feature(cfeature.BORDERS, linewidth=0.8, edgecolor=\"#444444\")\n\n# Zero-population cells (outside Germany, or uninhabited inside it) plotted\n# as transparent rather than dark-purple-at-zero, so the border/coastline\n# underneath does the work of showing Germany's outline.\npopulation = mask_ds[\"population_weight\"].where(mask_ds[\"population_weight\"] > 0)\npcm = ax.pcolormesh(\n    mask_ds[lon_name], mask_ds[lat_name], population,\n    transform=ccrs.PlateCarree(), cmap=\"viridis\", shading=\"auto\",\n)\nfig.colorbar(pcm, ax=ax, orientation=\"vertical\", pad=0.05, label=\"Population per grid cell\")\nax.set_title(\"Germany population-weighting mask (PECD v4.2 / SEDAC 2020)\")\nfig.tight_layout()\nfig.savefig(paths.germany_book_path / \"population_mask.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()","key":"yqHoad2sj9"},{"type":"outputs","id":"b1LCliapcR4zs0YyEMaVP","children":[],"key":"ohyoSwEA26"}],"key":"mHhxYpaIqY"},{"type":"block","kind":"notebook-content","children":[{"type":"container","kind":"figure","children":[{"type":"image","url":"/e2s-examples/build/population_mask-c22cd6e0a6bc8ef2cec5cd215ec62f87.png","alt":"Population per native grid cell across Germany - the weighting applied\nbelow instead of a flat area-weighted mean.","data":{"altTextIsAutoGenerated":true},"key":"eRKQg5UGeK","urlSource":"../../output/germany/book/population_mask.png"},{"type":"caption","children":[{